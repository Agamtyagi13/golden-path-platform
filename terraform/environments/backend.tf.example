# Copy to backend.tf for shared, locked state (S3 + DynamoDB). Demo uses local state.
terraform {
  backend "s3" {
    bucket         = "YOUR-tfstate-bucket"
    key            = "golden-path/environments.tfstate"
    region         = "ap-south-1"
    dynamodb_table = "tfstate-lock"
    encrypt        = true
  }
}
